<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WindowFlip</RootNamespace>
    <AssemblyName>WindowFlip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WindowFlip.ico</ApplicationIcon>
    <AssemblyTitle>WindowFlip</AssemblyTitle>
    <Description>Switch between windows of the current application</Description>
    <Company>WindowFlip</Company>
    <Product>WindowFlip</Product>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <ProjectReference Include="..\WindowFlip.Core\WindowFlip.Core.csproj" />
  </ItemGroup>
</Project>
